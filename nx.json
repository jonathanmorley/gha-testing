{
  "targetDefaults": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "root",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -b"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "root",
        "{projectRoot}/.oxlintrc.json",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tests/**/*.ts",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["oxlint"]
      },
      "configurations": {
        "fix": {
          "commands": ["oxlint --fix"],
          "parallel": false
        }
      }
    },
    "unit-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": [
        "root",
        "{projectRoot}/.oxlintrc.json",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tests/**/*.ts",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest",
        "args": ["--dir=tests/unit", "--passWithNoTests"]
      }
    },
    "integration-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "root",
        "{projectRoot}/.oxlintrc.json",
        "{projectRoot}/package.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tests/**/*.ts",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest",
        "args": ["--dir=tests/integration", "--passWithNoTests"]
      }
    },
    "test": {
      "dependsOn": ["unit-test"]
    }
  },
  "namedInputs": {
    "root": ["{workspaceRoot}/.github/workflows/*", "{workspaceRoot}/mise.toml"]
  },
  "release": {
    "projects": ["@jonathanmorley/typescript-library", "@jonathanmorley/typescript-application"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": false,
      "git": {
        "commit": true,
        "commitMessage": "chore(release): publish {projectName} {version}",
        "tag": true,
        "push": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true,
      "automaticFromRef": true
    }
  }
}
